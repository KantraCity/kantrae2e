{
	# Let's Encrypt account email.
	email {$ACME_EMAIL}
	# rate_limit comes from the caddy-ratelimit plugin (deploy/caddy.Dockerfile).
	order rate_limit before reverse_proxy
}

# Real hostname => automatic TLS (Let's Encrypt), HTTP/3 advertised via Alt-Svc
# when UDP/443 is open.
{$DOMAIN} {
	import Caddyfile.routes
}
