# Shared routing (imported by Caddyfile and Caddyfile.dev).
# `handle` keeps the full path: services serve exactly the paths below,
# the same with or without the gateway.

# Rate limits (caddy-ratelimit, per client IP). A request over the limit gets
# 429 with Retry-After. Behind a CDN/load balancer configure trusted_proxies
# so that {client_ip} is the real client.

# --- auth-service: brute-force protection first (roadmap Upgrade 2) ---
handle /kantra.auth.v1.AuthService/Login {
	rate_limit {
		zone auth_login {
			key {client_ip}
			events 5
			window 1m
		}
	}
	reverse_proxy auth-service:8080
}
handle /kantra.auth.v1.AuthService/Register {
	rate_limit {
		zone auth_register {
			key {client_ip}
			events 5
			window 1m
		}
	}
	reverse_proxy auth-service:8080
}
handle /kantra.auth.v1.AuthService/Recover {
	rate_limit {
		zone auth_recover {
			key {client_ip}
			events 5
			window 1m
		}
	}
	reverse_proxy auth-service:8080
}
handle /kantra.auth.v1.AuthService/RegisterDevice {
	rate_limit {
		zone auth_register_device {
			key {client_ip}
			events 5
			window 1m
		}
	}
	reverse_proxy auth-service:8080
}
handle /kantra.auth.v1.AuthService/* {
	rate_limit {
		zone api {
			key {client_ip}
			events 1200
			window 1m
		}
	}
	reverse_proxy auth-service:8080
}

# --- directory-service (KeyPackages) ---
handle /kantra.directory.v1.DirectoryService/* {
	rate_limit {
		zone api {
			key {client_ip}
			events 1200
			window 1m
		}
	}
	reverse_proxy directory-service:8081
}

# --- delivery-service, incl. WebSocket (Upgrade is proxied automatically) ---
# Joining groups by oneself is cheap to abuse: separate, tighter zone.
@selfjoin path /kantra.delivery.v1.DeliveryService/ExternalJoin /kantra.delivery.v1.DeliveryService/RequestJoin
handle @selfjoin {
	rate_limit {
		zone self_join {
			key {client_ip}
			events 60
			window 1m
		}
	}
	reverse_proxy delivery-service:8082
}
handle /kantra.delivery.v1.DeliveryService/* {
	rate_limit {
		zone api {
			key {client_ip}
			events 1200
			window 1m
		}
	}
	reverse_proxy delivery-service:8082
}
handle /v1/ws {
	reverse_proxy delivery-service:8082
}

# --- history-service ---
handle /kantra.history.v1.HistoryService/* {
	request_body {
		max_size 9MB
	}
	reverse_proxy history-service:8083
}

# --- media-service ---
handle /kantra.media.v1.MediaService/* {
	request_body {
		max_size 66MB
	}
	reverse_proxy media-service:8084
}

# --- everything else is a 404, never proxied somewhere by accident ---
# Invite links (https://<domain>/join/<group>#<secret>) opened in a browser:
# the secret after "#" never reaches the server; the page says what to do.
handle /join/* {
	header Content-Type "text/html; charset=utf-8"
	respond `<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><title>Приглашение в Kantra</title><body style="font-family:system-ui,sans-serif;background:#17212b;color:#f5f5f5;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;text-align:center"><div style="max-width:360px;padding:24px"><h2>Приглашение в группу Kantra</h2><p style="color:#9fb1c3">Скопируйте эту ссылку и вставьте её в поиск в приложении Kantra — вас добавят в группу.</p></div>` 200
}

handle {
	respond "Not found" 404
}

log {
	output file /var/log/caddy/access.log
	format json
}
