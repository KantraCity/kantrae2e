# Copy to deploy/.env and change every value.
DOMAIN=chat.example.com
ACME_EMAIL=you@example.com

# At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
TOKEN_TTL=24h
# Shared secret for service-to-service calls (>= 32 bytes), e.g. `openssl rand -hex 32`.
INTERNAL_TOKEN=change-me-change-me-change-me-change-me

POSTGRES_USER=kantra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kantra

MINIO_ROOT_USER=kantra
MINIO_ROOT_PASSWORD=change-me-at-least-8
# Override if minio/minio cannot be pulled (see deploy/minio.Dockerfile).
MINIO_IMAGE=minio/minio:latest
